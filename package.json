{
  "name": "webforge",
  "version": "0.1.0",
  "private": true,
  "description": "AAA WebForge: self-hosted Wix/Webflow-style template and component library with a GrapesJS editor.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "validate": "node scripts/validate-library.mjs",
    "index": "node scripts/build-index.mjs",
    "smoke": "node scripts/smoke-editor.mjs",
    "test": "node scripts/validate-library.mjs && node scripts/build-index.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@uiw/react-codemirror": "^4.23.12",
    "grapesjs": "^0.23.8",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-custom-code": "^1.0.2",
    "grapesjs-plugin-forms": "^2.0.6",
    "grapesjs-preset-webpage": "^1.0.3",
    "grapesjs-style-bg": "^2.0.2",
    "grapesjs-tabs": "^1.0.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.0",
    "typescript": "^5"
  }
}
